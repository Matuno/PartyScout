<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.9.0</Version>
    <Authors>Matuno</Authors>
    <Description>Find the right party and see who's playing.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DalamudUiProject Condition="'$(DalamudUiProject)' == '' and Exists('../DalamudUi/DalamudUi.csproj')">../DalamudUi/DalamudUi.csproj</DalamudUiProject>
    <DalamudUiProject Condition="'$(DalamudUiProject)' == ''">../../incubator/DalamudUi/DalamudUi.csproj</DalamudUiProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(DalamudUiProject)" />
    <None Include="LICENSE.md;THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$([System.IO.Path]::GetDirectoryName('$(DalamudUiProject)'))/LICENSE-*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="images\icon.png" LogicalName="PartyScout.images.icon.png" />
  </ItemGroup>
</Project>
